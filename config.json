{
  "server": { "host": "127.0.0.1", "port": 5000, "debug": false },
  "ssh": {
    "failed_attempts_threshold": 5,
    "auth_log_path": "/var/log/auth.log",
    "lines_to_analyze": 2000
  },
  "network": {
    "netplan_dir": "/etc/netplan",
    "resolv_conf": "/etc/resolv.conf",
    "dns_test_host": "debian.org"
  },
  "services": {
    "ssh_config_path": "/etc/ssh/sshd_config",
    "max_auth_tries": 4,
    "insecure_ports": { "8080": "Alternative HTTP (cleartext)" },
    "web_check_urls": ["http://127.0.0.1", "https://127.0.0.1"]
  },
  "auth": { "password_hash": "", "session_minutes": 30 },
  "fixes": {
    "ssh_dropin_dir": "/etc/ssh/sshd_config.d",
    "backup_dir": "backups",
    "block_private_ips": true
  },
  "logs": {
    "sources": {
      "auth": { "type": "file", "path": "/var/log/auth.log" },
      "syslog": { "type": "file", "path": "/var/log/syslog" },
      "ssh": { "type": "journal", "unit": "ssh" },
      "ufw": { "type": "file", "path": "/var/log/ufw.log" },
      "fixes": { "type": "file", "path": "fixes.log" }
    },
    "default_limit": 200
  },
  "hardening": {
    "critical_files": {
      "/etc/passwd": "644",
      "/etc/shadow": "640",
      "/etc/group": "644",
      "/etc/gshadow": "640",
      "/etc/sudoers": "440",
      "/etc/ssh/sshd_config": "644",
      "/etc/crontab": "644"
    }
  }
}
